# mir2mix.asuscomm.com 전용 설정
# 이 파일을 .env 로 복사해서 사용하세요: cp .env.mir2mix .env

# Telegram - @BotFather에서 발급
TELEGRAM_BOT_TOKEN=여기에_봇토큰_입력
ALLOWED_USER_IDS=  # 비워두면 모두 허용, 본인 ID만 하려면 숫자 입력 (예: 12345678)

# Nextcloud - mir2mix 개인 NAS
NEXTCLOUD_URL=https://mir2mix.asuscomm.com
NEXTCLOUD_USERNAME=여기에_Nextcloud_아이디
NEXTCLOUD_PASSWORD=여기에_앱비밀번호  # 중요! 일반 비번 말고 앱 비밀번호!
NEXTCLOUD_BASE_PATH=/PikPakBot
NEXTCLOUD_CHUNK_SIZE=10485760

# Aria2
ARIA2_HOST=http://aria2:6800
ARIA2_SECRET=mir2mix_pikpak_2024_secret!  # 아무거나 강력한 비번으로 변경

# 다운로드
DOWNLOAD_DIR=/downloads
MAX_CONCURRENT_DOWNLOADS=3
ENABLE_YTDLP=true
ENABLE_TORRENT=true
