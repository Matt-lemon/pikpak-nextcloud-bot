# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotTokenHere
# SECURITY: 필수. 비워두면 봇이 시작 거부됨 (예전 "비우면 모두 허용"은 Critical 패치로 제거됨)
ALLOWED_USER_IDS=12345678,87654321  # 쉼표로 구분, 본인 ID는 @userinfobot에서 확인
# ALLOW_UNAUTHENTICATED=true  # 모두 허용 (비권장, 테스트용)

# Nextcloud (필수)
NEXTCLOUD_URL=https://nextcloud.yourdomain.com
NEXTCLOUD_USERNAME=your_username
NEXTCLOUD_PASSWORD=your_app_password  # 설정 > 보안 > 앱 비밀번호 생성 권장
NEXTCLOUD_BASE_PATH=/PikPakBot  # Nextcloud 내부 저장 경로
NEXTCLOUD_CHUNK_SIZE=10485760  # 10MB 청크 업로드

# Aria2 (Docker 내부에서는 기본값 사용)
ARIA2_HOST=http://aria2:6800
ARIA2_SECRET=your_aria2_secret

# 다운로드 설정
DOWNLOAD_DIR=/downloads
MAX_CONCURRENT_DOWNLOADS=3
ENABLE_YTDLP=true
ENABLE_TORRENT=true

# 토렌트 제한 (2026-09-10 감사 추가) - 무한 대기/시딩 방지
TORRENT_TIMEOUT_HOURS=24   # 전체 제한 시간 (초과 시 중단·삭제)
TORRENT_STALL_MINUTES=60   # 진행 정체 허용 시간 (0 bytes 지속 시 중단·삭제)

# 대시보드 (2026-09-10 감사 추가) - 기본 127.0.0.1 바인드
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=강력한_비밀번호_필수
# DASHBOARD_REQUIRE_AUTH=true
# DASHBOARD_MAX_QUEUE=50
# DASHBOARD_MAX_CONCURRENT=3
# MAX_FILE_SIZE_GB=20  # 대시보드 경로 파일 크기 상한 (봇은 config.yaml 우선)
