# mir2mix.asuscomm.com 전용 설정
# 이 파일을 .env 로 복사해서 사용하세요: cp .env.mir2mix .env
# SECURITY: ALLOWED_USER_IDS는 필수 - 비우면 봇이 시작되지 않음 (Critical fix)

# Telegram - @BotFather에서 발급
TELEGRAM_BOT_TOKEN=여기에_봇토큰_입력
# SECURITY FIX: 비어있으면 모든 사용자 허용 -> Critical 취약점
# 본인 Telegram ID를 넣으세요 (예: 12345678)
# ID 확인: @userinfobot 에게 메시지 보내면 알 수 있음
ALLOWED_USER_IDS=여기에_본인_Telegram_ID_입력_필수

# Nextcloud - mir2mix 개인 NAS
NEXTCLOUD_URL=https://mir2mix.asuscomm.com
NEXTCLOUD_USERNAME=여기에_Nextcloud_아이디
NEXTCLOUD_PASSWORD=여기에_앱비밀번호  # 중요! 일반 비번 말고 앱 비밀번호!
NEXTCLOUD_BASE_PATH=/PikPakBot
NEXTCLOUD_CHUNK_SIZE=10485760

# Aria2 - SECURITY: 강력한 랜덤 비밀번호로 변경 필수
ARIA2_HOST=http://aria2:6800
ARIA2_SECRET=여기에_강력한_랜덤_비밀번호_입력_필수_예_mir2mix_pikpak_2024_secret!

# 다운로드
DOWNLOAD_DIR=/downloads
MAX_CONCURRENT_DOWNLOADS=3
ENABLE_YTDLP=true
ENABLE_TORRENT=true

# 대시보드 (선택) - SECURITY: 외부 노출 시 비밀번호 설정
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=여기에_대시보드_비밀번호

# 로컬 Bot API (대용량 파일용) - 선택
# TELEGRAM_API_ID, TELEGRAM_API_HASH는 https://my.telegram.org 에서 발급
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
